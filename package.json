{
  "name": "learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A hands-on course in AI agent engineering: a Next.js site to learn on and a Tauri desktop app to practice in.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content": "pnpm --filter @atlas/learning build",
    "content:watch": "pnpm --filter @atlas/learning watch",
    "content:check": "pnpm --filter @atlas/learning check",
    "dev": "pnpm content && pnpm --filter @atlas/web dev",
    "dev:desktop": "pnpm content && pnpm --filter @atlas/desktop dev",
    "dev:desktop:web": "pnpm content && pnpm --filter @atlas/desktop dev:web",
    "build": "pnpm content && pnpm --filter @atlas/web build",
    "build:desktop": "pnpm content && pnpm --filter @atlas/desktop tauri:build",
    "start": "pnpm --filter @atlas/web start",
    "validate:course": "pnpm --filter @atlas/learning validate:course",
    "validate:testcases": "pnpm --filter @atlas/learning validate:testcases",
    "validate": "pnpm validate:course && pnpm validate:testcases",
    "validate:all": "pnpm validate && pnpm typecheck && pnpm test:core && pnpm test:content && pnpm test:runner",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test:core": "pnpm --filter @atlas/core test",
    "test:content": "pnpm --filter @atlas/learning test",
    "test:rust": "cd apps/desktop/src-tauri && cargo test",
    "lint:rust": "cd apps/desktop/src-tauri && cargo clippy --all-targets -- -D warnings",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "clean": "rm -rf apps/*/dist apps/web/.next packages/*/dist **/*.tsbuildinfo",
    "test:runner": "pnpm --filter @atlas/learning test:runner"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  }
}
