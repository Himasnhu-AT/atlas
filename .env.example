# ---------------------------------------------------------------------------
# Firebase & Backend configuration
# ---------------------------------------------------------------------------
#
# Atlas connects to Cloud Firestore via Firebase Admin SDK.
# Configure your Firebase credentials in apps/web/.env.local.
#
# ---------------------------------------------------------------------------
# WHERE THIS FILE GOES
# ---------------------------------------------------------------------------
#
# Copy this file or apps/web/.env.example to apps/web/.env.local:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# `.env` and `.env.local` are gitignored; this example file is not.

# Firebase project credentials for apps/web:
FIREBASE_PROJECT_ID=synthai-learn
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Admin emails (comma-separated):
ADMIN_EMAILS=you@example.com

# Client Firebase configuration for Google Sign-In:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
