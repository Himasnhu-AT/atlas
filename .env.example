# ---------------------------------------------------------------------------
# Supabase configuration (entirely optional)
# ---------------------------------------------------------------------------
#
# Leave BOTH of these unset and the app runs in OFFLINE MOCK MODE:
# @atlas/core hands out a localStorage-backed AuthClient and ProgressStore, so
# sign-up, sign-in, lesson completion and saved code all work with zero
# configuration and no network. That is the default, supported way to run this
# project — you never need a Supabase project to take the course.
#
# Set BOTH and @atlas/core switches to real Supabase Auth plus the
# `lesson_progress` table, so accounts and progress sync across devices and
# between the web app and the desktop app. Setting only one is treated as
# unset (see `hasSupabase()` in packages/core/src/supabase.ts) and you stay
# offline.
#
# ---------------------------------------------------------------------------
# WHERE THIS FILE GOES
# ---------------------------------------------------------------------------
#
# Vite reads env files from each app's own directory, not from the monorepo
# root, and neither app sets `envDir`. So copy this file to the app you are
# running:
#
#   cp .env.example apps/web/.env.local        # the web app     (pnpm dev)
#   cp .env.example apps/desktop/.env.local    # the desktop app (pnpm dev:desktop)
#
# `.env` and `.env.local` are gitignored; this example file is not.
#
# Both variables are exposed to client-side JavaScript — that is what the
# `VITE_` prefix means. Only ever put the ANON (publishable) key here. The anon
# key is safe in a browser bundle *because* row-level security is enabled on
# every table; see supabase/schema.sql. Never put the service-role key in any
# `VITE_`-prefixed variable.

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
# Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# The anon / public key (a long JWT starting with `eyJ`).
# Supabase dashboard → Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=
