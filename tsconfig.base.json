{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,

    "noEmit": true,

    // TypeScript 7 removed `baseUrl`. Path mappings are resolved relative to the
    // config file that declares them — i.e. this file, at the repo root.
    "paths": {
      "@atlas/core": ["./packages/core/src/index.ts"],
      "@atlas/ui": ["./packages/ui/src/index.ts"],
      "@atlas/learning": ["./packages/learning/src/index.ts"],
      "@atlas/learning/schema": ["./packages/learning/src/schema.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "target", ".tmp-legacy"]
}
