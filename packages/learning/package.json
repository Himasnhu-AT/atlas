{
  "name": "@atlas/learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Course content: MDX lessons, Python exercises, and the build pipeline that validates and compiles them.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./manifest": "./dist/manifest.json"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "watch": "tsx scripts/build.ts --watch",
    "check": "tsx scripts/build.ts --check",
    "validate:course": "tsx scripts/build.ts --check",
    "validate:testcases": "python3 scripts/validate_crux_solutions.py",
    "test:runner": "python3 -m unittest discover -s runner -p 'test_*.py'",
    "validate": "tsx scripts/build.ts --check && python3 scripts/validate_crux_solutions.py",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts src/challenges/*.test.ts"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "@shikijs/rehype": "^4.4.3",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
