{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas Practice",
  "mainBinaryName": "Atlas Practice",
  "version": "0.1.0",
  "identifier": "dev.atlas.practice",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atlas Practice",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost https:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5174 http://localhost:5174 https:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "capabilities": [
        "default"
      ],
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost https:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5174 http://localhost:5174 http://localhost:5173 https:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Learn to build agentic AI systems",
    "longDescription": "An offline-first course platform for building agentic AI systems, with an embedded terminal and a sandboxed practice workspace.",
    "copyright": "Atlas Practice",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5OUNDQjYwODREMzg3NzIKUldSeWg5T0VZTXVjYVhJeEEvUzhZSG1NOXdSc3N6UVcydExsSVhUekd4LytORkhpcDJ0QUdwMFAK",
      "endpoints": [
        "https://github.com/Himasnhu-AT/atlas/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
