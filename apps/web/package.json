{
  "name": "@atlas/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js app: the student-facing site and the API backing both clients.",
  "scripts": {
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "predev": "node scripts/copy-pyodide.mjs && node scripts/copy-runner.mjs",
    "prebuild": "pnpm --filter @atlas/learning build && node scripts/copy-pyodide.mjs && node scripts/copy-runner.mjs"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "@atlas/learning": "workspace:*",
    "@atlas/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.4.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "pyodide": "^314.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
