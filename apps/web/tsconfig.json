{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@atlas/core": ["../../packages/core/src/index.ts"],
      "@atlas/ui": ["../../packages/ui/src/index.ts"],
      "@atlas/learning": ["../../packages/learning/src/index.ts"],
      "@atlas/learning/manifest": ["../../packages/learning/dist/manifest.json"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
