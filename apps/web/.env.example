# Copy to .env.local. Every variable here is optional: with none of them set,
# the app runs on local file storage and generates its own session key.

# Signs session cookies. Leave unset locally and one is generated into
# .data/session-secret. Set it explicitly before deploying, because a generated
# key is per machine and will not work across multiple instances.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Postgres. Set BOTH to move off local file storage, then apply
# supabase/schema.sql. The service role key is read only by lib/server/ and
# never reaches a browser or the desktop bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
