# Copy to .env.local.
# Firebase credentials and session key.

# Signs session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Firebase.
# The credentials are read only by lib/server/ and never reach a browser or the desktop bundle.
FIREBASE_PROJECT_ID=synthai-learn
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or provide the service account JSON path or string:
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Admin emails (comma-separated):
ADMIN_EMAILS=you@example.com

# Client Firebase configuration for Google Sign-In:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SITE_URL=https://atlas.himanshuat.com
